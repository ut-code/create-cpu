{
	"extends": "@tsconfig/strictest/tsconfig.json",
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		// Conflicts with CSS Modules
		"noPropertyAccessFromIndexSignature": false
	},
	"include": ["src"]
}
